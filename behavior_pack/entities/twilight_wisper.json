{
  "format_version": "1.21.110",
  "minecraft:entity": {
    "description": {
      "identifier": "crossover_expansion:twilight_wisper",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "crossover_expansion:teleport_allowed": {
        "minecraft:behavior.random_teleport": {
          "priority": 8,
          "success_chance": 0.08,
          "cooldown": 12,
          "avoid_water": true,
          "must_see": false
        }
      },
      "crossover_expansion:teleport_disabled": {},
      "crossover_expansion:fed_support": {
        "minecraft:particle_effect": {
          "effect": "biomes_beyond:jacaranda_leaf_particles"
        },
        "minecraft:timer": {
          "time": 30,
          "looping": false,
          "time_down_event": {
            "event": "crossover_expansion:end_support"
          }
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "twilight_wisper",
          "mob",
          "animal"
        ]
      },
      "minecraft:health": {
        "value": 12,
        "max": 12
      },
      "minecraft:collision_box": {
        "width": 0.65,
        "height": 1.1
      },
      "minecraft:movement": {
        "value": 0.22
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": false,
        "can_pass_doors": true
      },
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": true
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.15
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8,
        "probability": 0.08
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:behavior.move_towards_block": {
        "priority": 5,
        "speed_multiplier": 0.65,
        "search_range": 16,
        "block_type": [
          "biomes_beyond:jacaranda_lamp",
          "biomes_beyond:copper_torch"
        ]
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "test": "is_riding",
              "subject": "self",
              "value": true
            },
            "event": "crossover_expansion:disable_teleport"
          },
          {
            "filters": {
              "test": "is_riding",
              "subject": "self",
              "value": false
            },
            "event": "crossover_expansion:enable_teleport"
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "hand",
                    "value": "biomes_beyond:banana"
                  }
                ]
              },
              "event": "crossover_expansion:feed_support"
            },
            "use_item": true,
            "swing": true,
            "hurt_item": 0,
            "cooldown": 1.0
          },
          {
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "hand",
                    "value": "minecraft:apple"
                  }
                ]
              },
              "event": "crossover_expansion:feed_support"
            },
            "use_item": true,
            "swing": true,
            "hurt_item": 0,
            "cooldown": 1.0
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "crossover_expansion:teleport_allowed"
          ]
        }
      },
      "crossover_expansion:disable_teleport": {
        "remove": {
          "component_groups": [
            "crossover_expansion:teleport_allowed"
          ]
        },
        "add": {
          "component_groups": [
            "crossover_expansion:teleport_disabled"
          ]
        }
      },
      "crossover_expansion:enable_teleport": {
        "remove": {
          "component_groups": [
            "crossover_expansion:teleport_disabled"
          ]
        },
        "add": {
          "component_groups": [
            "crossover_expansion:teleport_allowed"
          ]
        }
      },
      "crossover_expansion:feed_support": {
        "add": {
          "component_groups": [
            "crossover_expansion:fed_support"
          ]
        },
        "queue_command": {
          "command": [
            "effect @a[r=5] night_vision 30 0 true"
          ]
        }
      },
      "crossover_expansion:end_support": {
        "remove": {
          "component_groups": [
            "crossover_expansion:fed_support"
          ]
        }
      }
    }
  }
}
